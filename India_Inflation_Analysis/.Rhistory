install.packages("strucchange")
library(strucchange)
model_chow_2016 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY`,
data = data
)
sctest(
model_chow_2016,
type = "Chow",
point = 12
)
sctest(
model_chow_2016,
type = "Chow",
point = 9
)
# Full sample
RSS_full <- sum(residuals(model_chow_2016)^2)
# Pre-2016
model_pre <- lm(
`Deflator YoY` ~ `WPI Inflation YoY`,
data = data[1:9, ]
)
# 2016 onward
model_post <- lm(
`Deflator YoY` ~ `WPI Inflation YoY`,
data = data[10:47, ]
)
RSS_pre <- sum(residuals(model_pre)^2)
RSS_post <- sum(residuals(model_post)^2)
k <- 2
n1 <- 9
n2 <- 38
F_chow <- ((RSS_full - RSS_pre - RSS_post) / k) /
((RSS_pre + RSS_post) / (n1 + n2 - 2*k))
p_value <- pf(F_chow, k, n1 + n2 - 2*k, lower.tail = FALSE)
F_chow
p_value
