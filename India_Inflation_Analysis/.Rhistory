bptest(model1)
# Serial autocorrelation
dwtest(model1)
# Autocorrelation up to 4 quarters
bgtest(model1, order = 4)
# Functional form
resettest(model1)
bptest(model2)
dwtest(model2)
bgtest(model2, order = 4)
resettest(model2)
vif(model3)
vif(model3)
bptest(model3)
bgtest(model3, order = 4)
resettest(model3)
