# ============================================================
# India Inflation Analysis
# Regression & Structural Break Analysis
# ============================================================
# Packages
library(lmtest)
library(ggplot2)
# ------------------------------------------------------------
# 1. Baseline models
# ------------------------------------------------------------
# Model 1: CPI only
model1 <- lm(
`Deflator YoY` ~ `CPI Inflation YoY`,
data = data
)
# Model 2: WPI only
model2 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY`,
data = data
)
# Model 3: CPI + WPI
model3 <- lm(
`Deflator YoY` ~ `CPI Inflation YoY` +
`WPI Inflation YoY`,
data = data
)
# ------------------------------------------------------------
# 2. Dynamic specifications
# ------------------------------------------------------------
# CPI lags
data$CPI_lag1 <- dplyr::lag(data$`CPI Inflation YoY`, 1)
data$CPI_lag2 <- dplyr::lag(data$`CPI Inflation YoY`, 2)
data_lag1 <- na.omit(data)
data_lag2 <- na.omit(data)
model4 <- lm(
`Deflator YoY` ~ `CPI Inflation YoY` + CPI_lag1,
data = data_lag1
)
model5 <- lm(
`Deflator YoY` ~ `CPI Inflation YoY` +
CPI_lag1 + CPI_lag2,
data = data_lag2
)
# WPI lags
data$WPI_lag1 <- dplyr::lag(data$`WPI Inflation YoY`, 1)
data$WPI_lag2 <- dplyr::lag(data$`WPI Inflation YoY`, 2)
data_wpi_lag <- na.omit(data)
data_wpi_lag2 <- na.omit(data)
model6 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY` + WPI_lag1,
data = data_wpi_lag
)
model7 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY` +
WPI_lag1 + WPI_lag2,
data = data_wpi_lag2
)
# ------------------------------------------------------------
# 3. Nonlinear specification
# ------------------------------------------------------------
model8 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY` +
I(`WPI Inflation YoY`^2),
data = data
)
# ------------------------------------------------------------
# 4. Structural break specifications
# ------------------------------------------------------------
# 2016 break
data$Break2016 <- ifelse(
as.integer(substr(data$Period, 1, 4)) >= 2016,
1,
0
)
model_break2016 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY` +
Break2016 +
`WPI Inflation YoY`:Break2016,
data = data
)
# 2020 break
data$Break2020 <- ifelse(
as.integer(substr(data$Period, 1, 4)) >= 2020,
1,
0
)
model_break2020 <- lm(
`Deflator YoY` ~ `WPI Inflation YoY` +
Break2020 +
`WPI Inflation YoY`:Break2020,
data = data
)
# ------------------------------------------------------------
# 5. Model comparison
# ------------------------------------------------------------
model_comparison <- data.frame(
Model = c(
"CPI only",
"WPI only",
"CPI + WPI",
"WPI + WPI²"
),
R2 = c(
summary(model1)$r.squared,
summary(model2)$r.squared,
summary(model3)$r.squared,
summary(model8)$r.squared
)
)
print(model_comparison)
# ------------------------------------------------------------
# 6. Diagnostic tests for main models
# ------------------------------------------------------------
cat("\n--- Model 1 Diagnostics ---\n")
print(bptest(model1))
print(bgtest(model1, order = 4))
print(resettest(model1))
cat("\n--- Model 2 Diagnostics ---\n")
print(bptest(model2))
print(bgtest(model2, order = 4))
print(resettest(model2))
cat("\n--- Model 3 Diagnostics ---\n")
print(bptest(model3))
print(bgtest(model3, order = 4))
print(resettest(model3))
cat("\n--- Model 8 Diagnostics ---\n")
print(bptest(model8))
print(bgtest(model8, order = 4))
print(resettest(model8))
# ------------------------------------------------------------
# 7. Structural break results
# ------------------------------------------------------------
cat("\n--- 2016 Break Model ---\n")
print(summary(model_break2016))
cat("\n--- 2020 Break Model ---\n")
print(summary(model_break2020))
final_results <- data.frame(
Model = c(
"CPI only",
"WPI only",
"CPI + WPI",
"WPI + WPI²"
),
R_squared = c(
summary(model1)$r.squared,
summary(model2)$r.squared,
summary(model3)$r.squared,
summary(model8)$r.squared
),
Adjusted_R_squared = c(
summary(model1)$adj.r.squared,
summary(model2)$adj.r.squared,
summary(model3)$adj.r.squared,
summary(model8)$adj.r.squared
)
)
final_results$R_squared <- round(
final_results$R_squared, 3
)
final_results$Adjusted_R_squared <- round(
final_results$Adjusted_R_squared, 3
)
print(final_results)
install.packages("gt")
